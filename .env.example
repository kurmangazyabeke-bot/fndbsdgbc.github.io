# MATHQADAM AI - ENVIRONMENT CONFIGURATION (19-ҚАДАМ)

# 1. Supabase Config (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. AI Provider Selection ('mock' | 'openai' | 'gemini' | 'deepseek' | 'groq')
# Defaults to 'mock' for offline execution if no API keys are set.
AI_PROVIDER=mock

# 3. OpenAI / DeepSeek / Groq API (Server-side only, never exposed to client)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 4. Google Gemini API (Server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
